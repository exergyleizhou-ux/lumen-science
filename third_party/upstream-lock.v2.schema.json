{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exergyleizhou-ux.github.io/lumen-science/upstream-lock.v2.schema.json",
  "title": "Lumen Science nine-source upstream intake lock",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "recorded_at",
    "policy",
    "expected_source_ids",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "enum": [
        "draft",
        "active"
      ]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object"
    },
    "expected_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "exact_commit",
        "archive_sha256",
        "rights_status",
        "root_license",
        "nested_license_scan",
        "components"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "exact_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rights_status": {
          "const": "verified"
        },
        "root_license": {
          "type": "object"
        },
        "nested_license_scan": {
          "type": "object"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "path",
        "asset_kind",
        "disposition",
        "reuse_mode",
        "rights_status",
        "execution_authority",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "asset_kind": {
          "enum": [
            "code",
            "skill",
            "data",
            "model",
            "binary",
            "service",
            "document"
          ]
        },
        "disposition": {
          "enum": [
            "vendor",
            "adapt",
            "clean-room",
            "catalog-only",
            "quarantine",
            "reject-authority",
            "reject-license",
            "reject-data-model"
          ]
        },
        "reuse_mode": {
          "enum": [
            "none",
            "vendor",
            "adapt",
            "clean-room",
            "catalog-only"
          ]
        },
        "rights_status": {
          "enum": [
            "verified",
            "restricted"
          ]
        },
        "execution_authority": {
          "const": "none"
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  }
}
